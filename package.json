{
  "name": "@vizhub/udc",
  "version": "0.1.0",
  "description": "A portable, provenance-aware semantic data cube engine for JavaScript and TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Curran Kelleher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curran/udc.git"
  },
  "homepage": "https://github.com/curran/udc#readme",
  "bugs": {
    "url": "https://github.com/curran/udc/issues"
  },
  "keywords": [
    "udc",
    "data-cube",
    "semantic",
    "data-integration",
    "provenance",
    "data-visualization",
    "typescript",
    "d3"
  ],
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test tsup.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/verify-package.mjs && npm pack --dry-run",
    "format": "prettier --write src test examples scripts tsup.config.ts vitest.config.ts package.json",
    "format:check": "prettier --check src test examples scripts tsup.config.ts vitest.config.ts package.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "example": "npm run build && node examples/population-gdp.mjs"
  },
  "dependencies": {
    "d3-dsv": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.9"
  }
}
