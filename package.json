{
  "name": "@vizhub/udc",
  "version": "2.0.0",
  "description": "A portable, provenance-aware semantic data cube engine for JavaScript and TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Curran Kelleher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizhub-studio/udc.git"
  },
  "homepage": "https://github.com/vizhub-studio/udc#readme",
  "bugs": {
    "url": "https://github.com/vizhub-studio/udc/issues"
  },
  "keywords": [
    "udc",
    "data-cube",
    "semantic",
    "data-integration",
    "provenance",
    "data-visualization",
    "typescript",
    "d3"
  ],
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test tsup.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/verify-package.mjs && npm pack --dry-run",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "format": "npm run prettier",
    "format:check": "npm run prettier:check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "example": "npm run build && node examples/population-gdp.mjs"
  },
  "dependencies": {
    "d3-dsv": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
